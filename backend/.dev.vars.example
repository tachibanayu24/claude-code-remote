# Local dev secrets used by `wrangler dev`. Copy to `.dev.vars` and fill in.
# Production secrets are set via `wrangler secret put <NAME>` (do NOT commit).

# 32-byte hex string. Generate with: openssl rand -hex 32
SHARED_SECRET=replace_me

# GCP project ID that owns the FCM project.
FCM_PROJECT_ID=your-gcp-project-id

# Service account JSON (single line). Download from GCP console → IAM → Service accounts.
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
