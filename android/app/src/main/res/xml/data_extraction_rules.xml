<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false in the manifest so these rules are belt-and-braces.
  DataStore writes under `datastore/<name>.preferences_pb`, NOT sharedpref —
  the previous `domain="sharedpref"` exclusion never matched. Even if a
  future change enables backup, this keeps the bearer token off the cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cc_remote_config.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cc_remote_config.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
