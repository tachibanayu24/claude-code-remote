<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the cc-remote sessions widget.

  Sizing:
  - targetCellWidth/Height (4x3) is the preferred footprint on Android 12+.
  - minWidth/Height is the legacy fallback for pre-12 launchers.
  - resizeMode lets users grow/shrink to taste; the Glance UI uses
    SizeMode.Responsive to switch layouts at known breakpoints.

  updatePeriodMillis=0: the periodic refresh is driven by WorkManager (15min,
  battery-aware) and FCM-triggered one-shot work. The system's per-30min
  alarm-based update is too coarse and runs even when the user just opened
  the app.

  initialLayout: Glance ships a default loading layout we can reference
  directly — no need to author a manual RemoteViews layout.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:updatePeriodMillis="0"
    android:description="@string/widget_description"
    android:previewImage="@drawable/ic_clawd" />
