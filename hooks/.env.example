# Copy to ~/.claude/hooks/.env and fill in.
# This file is read by cc-remote-hook.mjs at every Claude Code hook fire.

# Workers backend URL (no trailing slash)
CC_REMOTE_BACKEND_URL=https://claude-code-remote.<your-subdomain>.workers.dev

# Same shared secret registered in Workers (see backend/.dev.vars or `wrangler secret list`)
CC_REMOTE_SHARED_SECRET=replace_with_32_byte_hex_string
